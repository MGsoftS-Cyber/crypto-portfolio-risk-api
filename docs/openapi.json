  "components": {
    "schemas": {
      "AnalysisInput": {
        "properties": {
          "dataset_id": {
            "type": "string",
            "maxLength": 36,
            "minLength": 1,
            "title": "Dataset Id"
          },
          "as_of": {
            "type": "string",
            "format": "date",
            "title": "As Of"
          },
          "name": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Name",
            "default": "Portfolio review"
          },
          "enable_ml": {
            "type": "boolean",
            "title": "Enable Ml",
            "default": true
          },
          "concentration_limit": {
            "type": "number",
            "maximum": 1.0,
            "exclusiveMinimum": 0.0,
            "title": "Concentration Limit",
            "default": 0.6
          },
          "daily_change_limit": {
            "type": "number",
            "maximum": 1.0,
            "exclusiveMinimum": 0.0,
            "title": "Daily Change Limit",
            "default": 0.1
          },
          "turnover_limit": {
            "type": "number",
            "maximum": 100.0,
            "exclusiveMinimum": 0.0,
            "title": "Turnover Limit",
            "default": 0.5
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "dataset_id",
          "as_of"
        ],
        "title": "AnalysisInput"
      },
      "Credentials": {
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "minLength": 3,
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 12,
            "title": "Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "Credentials"
      },
      "CsvInput": {
        "properties": {
          "transactions_csv": {
            "type": "string",
            "maxLength": 2000000,
            "minLength": 1,
            "title": "Transactions Csv"
          },
          "prices_csv": {
            "type": "string",
            "maxLength": 4000000,
            "title": "Prices Csv",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "transactions_csv"
        ],
        "title": "CsvInput"
      },
      "DatasetInput": {
        "properties": {
          "source": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Source"
          },
          "coverage_end": {
            "type": "string",
            "format": "date",
            "title": "Coverage End"
          },
          "transactions": {
            "items": {
              "$ref": "#/components/schemas/TransactionInput"
            },
            "type": "array",
            "maxItems": 10000,
            "minItems": 1,
            "title": "Transactions"
          },
          "prices": {
            "items": {
              "$ref": "#/components/schemas/PriceInput"
            },
            "type": "array",
            "maxItems": 40000,
            "title": "Prices"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "source",
          "coverage_end",
          "transactions"
        ],
        "title": "DatasetInput"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "PortfolioInput": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Name"
          },
          "base_currency": {
            "type": "string",
            "const": "USD",
            "title": "Base Currency",
            "default": "USD"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name"
        ],
        "title": "PortfolioInput"
      },
      "PriceInput": {
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "title": "Date"
          },
          "asset_id": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "title": "Asset Id"
          },
          "close": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1000000000000000.0,
                "minimum": 0.0
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,16}|(?=[\\d.]{1,29}0*$)\\d{0,16}\\.\\d{0,12}0*$)"
              }
            ],
            "title": "Close"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "date",
          "asset_id",
          "close"
        ],
        "title": "PriceInput"
      },
      "QuotesInput": {
        "properties": {
          "asset_ids": {
            "items": {
              "type": "string",
              "maxLength": 80,
              "minLength": 1,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            "type": "array",
            "maxItems": 20,
            "minItems": 1,
            "title": "Asset Ids"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "asset_ids"
        ],
        "title": "QuotesInput"
      },
      "TransactionInput": {
        "properties": {
          "transaction_id": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "title": "Transaction Id"
          },
          "date": {
            "type": "string",
            "format": "date",
            "title": "Date"
          },
          "sequence": {
            "type": "integer",
            "maximum": 1000000.0,
            "minimum": 1.0,
            "title": "Sequence"
          },
          "kind": {
            "type": "string",
            "enum": [
              "deposit",
              "withdrawal",
              "buy",
              "sell"
            ],
            "title": "Kind"
          },
          "asset_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 80,
                "minLength": 1,
